# ---------------------------------------------------------------------------
# PHP version for THIS directory only.
#
# Laravel 13 requires PHP >= 8.3 (laravel/framework: "php": "^8.3"). If the
# browser shows:
#
#   Composer detected issues in your platform: Your Composer dependencies
#   require a PHP version ">= 8.3.0"
#
# ...the web PHP is older than the CLI PHP that ran `composer install`.
#
# Setting it in cPanel -> MultiPHP Manager changes the WHOLE domain, which also
# moves WordPress at the root. Uncomment ONE line below instead to raise only
# /app, leaving WordPress on whatever it runs today.
#
# ACTIVE below: alt-php84. Every path under /app returned that exact Composer
# error after a deploy, so the handler is no longer optional. The string is the
# one cPanel itself generated for droprsvp on this same account, which is how we
# know the package is installed and spelled this way:
#
#   AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
#
# If a handler is wrong the browser DOWNLOADS the PHP file instead of running it
# (and PHP source is then public — undo immediately). In that case the string
# does not match an installed version; try one of these instead:
#
#   application/x-httpd-ea-php84            # EasyApache build
#   application/x-httpd-alt-php84___lsphp   # CloudLinux / LiteSpeed
#   application/x-httpd-alt-php83           # if 8.4 is not installed
#
# Comment the block out again to undo. Setting it in cPanel -> MultiPHP Manager
# instead would change the WHOLE domain, moving WordPress at the root too; this
# raises only /app.
# ---------------------------------------------------------------------------

<IfModule mime_module>
    AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Mounted at https://portalkahwin.com/app — anchor rewrites to that prefix.
    # Harmless at a domain root; delete only if you move the app to its own domain.
    RewriteBase /app

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The JSON API is never a search result, so it keeps a blanket noindex. The app's
# own pages do NOT: whether a page may be indexed is decided per path in PHP
# (App\Support\AppSeo), which is the only place that knows a /e/<slug> card is
# published, or that /pass/<token> is a credential and must never be indexed.
#
# This used to be an unconditional `Header always set X-Robots-Tag "noindex,
# nofollow, noarchive"` for the whole directory. That single line is why nothing
# under /app could be crawled: an X-Robots-Tag header overrides any <meta
# name="robots"> in the HTML, so no amount of page-level SEO could take effect
# while it was there.
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        # Matches whether the app is mounted at /app or at a domain root.
        SetEnvIf Request_URI "^(/app)?/api/" PK_NOINDEX=1
    </IfModule>
    Header always set X-Robots-Tag "noindex, nofollow" env=PK_NOINDEX
</IfModule>
