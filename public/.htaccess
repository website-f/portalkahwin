# ---------------------------------------------------------------------------
# PHP version for THIS directory only.
#
# Laravel 13 requires PHP >= 8.3 (laravel/framework: "php": "^8.3"). If the
# browser shows:
#
#   Composer detected issues in your platform: Your Composer dependencies
#   require a PHP version ">= 8.3.0"
#
# ...the web PHP is older than the CLI PHP that ran `composer install`.
#
# Setting it in cPanel -> MultiPHP Manager changes the WHOLE domain, which also
# moves WordPress at the root. Uncomment ONE line below instead to raise only
# /app, leaving WordPress on whatever it runs today.
#
# This account's CLI is PHP 8.4, so ea-php84 is installed on the box — it is
# simply not the version serving the domain. Try 84 first, then 83.
#
# <IfModule mime_module>
#   AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
# </IfModule>
#
# CloudLinux / LiteSpeed accounts use this form instead:
# <IfModule mime_module>
#   AddHandler application/x-httpd-alt-php84___lsphp .php .php8 .phtml
# </IfModule>
#
# If a handler is wrong the browser DOWNLOADS the PHP file instead of running it.
# That means the string does not match an installed version — try the other form,
# or the 83 equivalent. Comment the block out again to undo.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Mounted at https://portalkahwin.com/app — anchor rewrites to that prefix.
    # Harmless at a domain root; delete only if you move the app to its own domain.
    RewriteBase /app

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Keep the app out of search results. This header is the load-bearing part:
# robots.txt is only read from the DOMAIN ROOT, so /app/robots.txt is ignored by
# crawlers entirely. A header applies to every response including the JSON API.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>
